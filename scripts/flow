#!/usr/bin/env bash

set -Eeuo pipefail

SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
DOTFILES_DIR="$(cd -- "$SOURCE_DIR/.." &>/dev/null && pwd)"
LIB_DIR="$DOTFILES_DIR/lib"

source "$LIB_DIR/workflow/core.sh"
source "$LIB_DIR/workflow/git.sh"
source "$LIB_DIR/workflow/flow/start.sh"
source "$LIB_DIR/workflow/flow/done.sh"
source "$LIB_DIR/workflow/flow/status.sh"
source "$LIB_DIR/workflow/flow/release.sh"
source "$LIB_DIR/workflow/flow/clean.sh"

usage() {
  cat <<'EOF'
Usage:
  flow start
  flow done ["title"] ["description"]
  flow clean
  flow release <version>
  flow status
  flow help

Commands:
  start    Select/create feature branch from develop
  done     Push feature branch and open PR targeting develop
  clean    Switch to develop, pull changes, and delete feature branch
  release  Merge develop to main, tag the release, sync, and push
  status   Show the current Git status
  help     Show this help
EOF
}

main() {
  local command="${1:-help}"

  shift || true

  case "$command" in
    start)
      cmd_start "$@"
      ;;

    done)
      cmd_done "$@"
      ;;

    status)
      cmd_status "$@"
      ;;

    clean)
      cmd_clean "$@"
      ;;

    release)
      cmd_release "$@"
      ;;

    help | --help | -h)
      usage
      ;;

    *)
      usage >&2
      die "unknown command '$command'"
      ;;
  esac
}

main "$@"
