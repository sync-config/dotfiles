#!/usr/bin/env python3
import sys, subprocess, json, uuid

TAG = "sprint_book"

def run_task(*args):
    return subprocess.run(["task", *args], text=True, capture_output=True)

def cmd_add(title, total):
    pace = (total + 29) // 30
    key = uuid.uuid4().hex
    run_task("add", f"Reading: {title}", "project:Health", "+routine", "+sprint", f"+{TAG}", 
             f"sbook_title:{title}", f"sbook_key:{key}", f"sbook_total:{total}", 
             "sbook_done:0", f"sbook_pace:{pace}", "due:today")
    print(f"Started '{title}'. Pace: {pace} pages/day.")

def cmd_show(title):
    res = run_task("rc.json.array=on", f"+{TAG}", "status:pending", "export")
    tasks = json.loads(res.stdout)
    match = next((t for t in tasks if t.get("sbook_title") == title), None)
    if match:
        d, t, p = int(match["sbook_done"]), int(match["sbook_total"]), int(match["sbook_pace"])
        print(f"Book: {title}\nProgress: {d}/{t}\nNext: {d+1}-{min(t, d+p)}")
    else:
        print("No active reading task found.")

if __name__ == "__main__":
    if len(sys.argv) > 2: cmd_add(sys.argv[1], int(sys.argv[2]))
    elif len(sys.argv) == 2: cmd_show(sys.argv[1])
