#!/usr/bin/env bash

# --- SPRINT_BOOK_SHIM ---
if [ "${1:-}" = "book" ]; then
    shift
    exec "$HOME/.dotfiles/bin/sprint-book" "$@"
fi
# ------------------------

set -euo pipefail

# Configuration
TARGET_FILE="${HOME}/.sprint_target"
RETRO_FILE="${HOME}/.task/.sprint_retrospective.md"
DEFAULT_TARGET=7

# Calculate current week start (Saturday 00:00:00)
get_saturday_sow() {
    local dow days_back
    dow=$(date +%u) # 1=Mon, ..., 6=Sat, 7=Sun
    days_back=$(( (dow + 1) % 7 ))
    echo "$(date -d "$days_back days ago" +%Y-%m-%d)T00:00:00"
}

# Fetch configured capacity target
get_target() {
    if [[ -f "$TARGET_FILE" ]]; then
        cat "$TARGET_FILE"
    else
        echo "$DEFAULT_TARGET"
    fi
}

# 1. Main Dashboard View
show_dashboard() {
    clear
    local target week_start committed velocity health
    target=$(get_target)
    week_start=$(get_saturday_sow)

    echo "==============================================="
    echo "         🎯 PERSONAL SPRINT DASHBOARD          "
    echo "==============================================="

    # Active Project Tasks
    task +sprint -routine status:pending rc.report.sprint.columns:id,project,description,points,urgency rc.report.sprint.labels:ID,Project,Description,Pts,Urg sprint 2>/dev/null || task +sprint -routine status:pending

    echo "-----------------------------------------------"
    
    # Calculate committed points in backlog/pending
    committed=$(task +sprint -routine status:pending export 2>/dev/null | jq '[.[].points // 0] | add // 0' 2>/dev/null || echo 0)
    [[ -z "$committed" || "$committed" == "null" ]] && committed=0

    # Calculate velocity completed since Saturday
    velocity=$(task +sprint -routine status:completed end.after:"$week_start" export 2>/dev/null | jq '[.[].points // 0] | add // 0' 2>/dev/null || echo 0)
    [[ -z "$velocity" || "$velocity" == "null" ]] && velocity=0

    echo "📊 Capacity Target : ${target} pts"
    echo "📌 Committed Scope : ${committed} pts"
    echo "🚀 Velocity (Sat+) : ${velocity} pts"

    if (( committed > target )); then
        health="⚠️  OVER-COMMITTED (Scope Exceeds Capacity)"
    elif (( committed == target )); then
        health="✅ BALANCED (Optimally Loaded)"
    else
        health="🟢 UNDER CAPACITY (Ready for more)"
    fi
    echo "🩺 Sprint Health   : ${health}"
    echo "==============================================="
}

# 2. Planning Ceremony
planning_ceremony() {
    clear
    local target committed
    target=$(get_target)
    committed=$(task +sprint -routine status:pending export 2>/dev/null | jq '[.[].points // 0] | add // 0' 2>/dev/null || echo 0)
    [[ -z "$committed" || "$committed" == "null" ]] && committed=0

    echo "==============================================="
    echo "       📋 SPRINTOS | SPRINT PLANNING           "
    echo "==============================================="
    echo "🎯 Weekly Capacity Target: ${target} pts"
    echo "📌 Currently Selected    : ${committed} pts"
    echo ""
    echo "Available Ready Backlog Items:"
    task -sprint -routine status:pending rc.report.next.columns:id,project,description,points,urgency rc.report.next.labels:ID,Project,Description,Pts,Urg next 2>/dev/null || true
    echo "-----------------------------------------------"
    echo "Action shortcuts:"
    echo "  1) Add task to sprint : sprint add <ID>"
    echo "  2) Adjust target      : sprint target <PTS>"
    echo "==============================================="
}

# 3. Daily Standup Ceremony
daily_ceremony() {

    touch "/tmp/.sprint_daily_checked_$(date +'%Y-%m-%d')"

    # Auto-complete today's Daily Scrum task if pending
    local daily_task_id
    daily_task_id=$(task +scrum description~"Sprint Daily" status:pending +READY _ids 2>/dev/null | head -n 1)

    if [[ -n "$daily_task_id" ]]; then
        task "$daily_task_id" done >/dev/null
        echo -e "✅ [Scrum] Sprint Daily marked as completed for today.\n"
    fi

    clear
    echo "==============================================="
    echo "         🚀 SPRINTOS | DAILY SCRUM             "
    echo "==============================================="

    echo -e "\n--- 🏛️ Scrum Ceremonies Today ---"

    local scrum_count
    scrum_count=$(task +scrum status:pending +READY count 2>/dev/null || echo 0)
    
    if [[ "$scrum_count" -gt 0 ]]; then
        task +scrum status:pending +READY rc.report.daily_scrum.columns:id,description,due rc.report.daily_scrum.labels:ID,Ceremony,Due daily_scrum 2>/dev/null
    else
        echo "No Scrum ceremonies scheduled for today."
    fi

    # 2. 🏃 Habits & Routines
    echo -e "\n--- 🏃 Habits & Routines ---"
    task +routine status:pending +READY -scrum rc.report.daily_routines.columns:id,project,description,due rc.report.daily_routines.labels:ID,Project,Description,Due daily_routines 2>/dev/null || true

    # 3. 🎯 Top Priorities for Today (Sprint Tasks)
    echo -e "\n--- 🎯 Top Priorities for Today ---"
    task +sprint -routine -scrum status:pending -BLOCKED limit:5 rc.report.daily_tasks.columns:id,project,points,urgency,description rc.report.daily_tasks.labels:ID,Project,Pts,Urg,Description daily_tasks 2>/dev/null || true

    echo "-----------------------------------------------"
    echo "Quick Actions:"
    echo "  task <id> done"
    echo "  task <id> modify wait:tomorrow due:tomorrow"
    echo "==============================================="
}

# 4. Review Ceremony
review_ceremony() {
    clear
    local week_start velocity completed_count
    week_start=$(get_saturday_sow)
    
    velocity=$(task +sprint -routine status:completed end.after:"$week_start" export 2>/dev/null | jq '[.[].points // 0] | add // 0' 2>/dev/null || echo 0)
    [[ -z "$velocity" || "$velocity" == "null" ]] && velocity=0
    
    completed_count=$(task +sprint -routine status:completed end.after:"$week_start" count 2>/dev/null || echo 0)

    echo "==============================================="
    echo "         🏁 SPRINTOS | SPRINT REVIEW           "
    echo "==============================================="
    echo "📅 Sprint Cycle : Since Saturday ($(echo "$week_start" | cut -d'T' -f1))"
    echo "🎯 Velocity Done: ${velocity} pts (${completed_count} tasks completed)"
    echo "-----------------------------------------------"
    echo "Delivered User Stories & Tasks:"
    task +sprint -routine status:completed end.after:"$week_start" sprint_done 2>/dev/null || true
    echo "==============================================="
}

# 5. Retrospective Ceremony
retro_ceremony() {
    clear
    local date_str week_start velocity target good bad actions
    date_str=$(date +%Y-%m-%d)
    week_start=$(get_saturday_sow)
    target=$(get_target)
    velocity=$(task +sprint -routine status:completed end.after:"$week_start" export 2>/dev/null | jq '[.[].points // 0] | add // 0' 2>/dev/null || echo 0)
    [[ -z "$velocity" || "$velocity" == "null" ]] && velocity=0

    echo "==============================================="
    echo "     🔍 SPRINTOS | SPRINT RETROSPECTIVE        "
    echo "==============================================="
    echo "Week Ending: ${date_str}"
    echo "Target: ${target} pts | Delivered: ${velocity} pts"
    echo "-----------------------------------------------"

    read -r -p "🟢 What went well this week? " good
    read -r -p "🔴 What needs improvement? " bad
    read -r -p "💡 Concrete Action Item for next sprint: " actions

    {
        echo "## 📅 Sprint Retro: ${date_str}"
        echo "- **Cycle Start:** ${week_start}"
        echo "- **Velocity:** Delivered ${velocity} / ${target} target pts"
        echo "- **Went Well:** ${good}"
        echo "- **Issues:** ${bad}"
        echo "- **Action Plan:** ${actions}"
        echo ""
    } >> "$RETRO_FILE"

    echo "-----------------------------------------------"
    echo "✅ Retrospective logged into: ${RETRO_FILE}"
    echo "==============================================="
}

# 6. Backlog Refinement Ceremony
refine_ceremony() {
    clear
    echo "==============================================="
    echo "       🔨 SPRINTOS | BACKLOG REFINEMENT        "
    echo "==============================================="
    echo "Tasks missing Story Points (points:none):"
    task status:pending 'points:""' rc.report.next.columns:id,project,description,urgency rc.report.next.labels:ID,Project,Description,Urg next 2>/dev/null || true
    echo "-----------------------------------------------"
    echo "Refinement actions:"
    echo "  Set points : task <id> modify points:<1|2|3|5>"
    echo "  Break down : task <id> modify depends:<parent_id>"
    echo "==============================================="
}

# Set Target Capacity
set_target() {
    if [[ -z "${1:-}" ]]; then
        echo "Usage: sprint target <points>"
        exit 1
    fi
    echo "$1" > "$TARGET_FILE"
    echo "🎯 Sprint capacity target set to: $1 pts"
}

# Add Task to Sprint
add_task() {
    if [[ -z "${1:-}" ]]; then
        echo "Usage: sprint add <task-id>"
        exit 1
    fi
    task "$1" modify +sprint
    echo "✅ Task $1 committed to sprint."
}

# Manage task Markdown documentation (supports ID and UUID/short-UUID)
task_doc() {
    local input_id="${1:-}"
    if [[ -z "$input_id" ]]; then
        echo "❌ Usage: sprint doc <task-id-or-uuid>"
        return 1
    fi

    local doc_dir="${HOME}/.task/.sprint_docs"
    mkdir -p "$doc_dir"

    # Fetch task details via JSON
    local task_json uuid desc project filepath editor_cmd
    
    # Taskwarrior resolves both ID and UUID prefixes automatically in export
    task_json=$(task "$input_id" export 2>/dev/null)

    # Check if task exists and is unique
    if [[ -z "$task_json" || "$task_json" == "[]" ]]; then
        echo "❌ Task '${input_id}' not found."
        return 1
    fi

    # Ensure we only have one task
    local count
    count=$(echo "$task_json" | jq '. | length')
    if [[ "$count" -gt 1 ]]; then
        echo "⚠️ Multiple tasks found for '${input_id}'. Please be more specific."
        return 1
    fi

    uuid=$(echo "$task_json" | jq -r '.[0].uuid')
    local short_uuid="${uuid:0:8}"
    desc=$(echo "$task_json" | jq -r '.[0].description')
    project=$(echo "$task_json" | jq -r '.[0].project // "General"')
    
    # Sanitize project name for filename
    local safe_project
    safe_project=$(echo "$project" | sed 's/[^a-zA-Z0-9_-]/_/g')
    
    filepath="${doc_dir}/${short_uuid}-${safe_project}.md"
    editor_cmd="${EDITOR:-nvim}"

    # If document does not exist, create template
    if [[ ! -f "$filepath" ]]; then
        cat << EOF > "$filepath"
# Task: ${desc}

- **Project:** ${project}
- **UUID:** \`${uuid}\`
- **Created at:** $(date +'%Y-%m-%d %H:%M')

---

## 🎯 Objective & Description
<!-- Describe the core goal of this task -->
- ${desc}

## ✅ Acceptance Criteria (Definition of Done)
- [ ] Criteria 1: 
- [ ] Criteria 2: 

## 📝 Implementation Notes & Logs


## 🔗 References & Links

EOF
        # Link document path to task attribute
        task "$uuid" modify doc:"$filepath" >/dev/null
        echo "📄 Created documentation: $filepath"
    fi

    # Open with user preferred editor
    "$editor_cmd" "$filepath"
}

cmd_book() {
    local title="$1"
    local total_pages="$2"

    if [[ -z "$title" || -z "$total_pages" ]]; then
        echo "❌ Usage: sprint book <\"Book Title\"> <TotalPages>"
        return 1
    fi

    local pages_per_day=$(( (total_pages + 29) / 30 ))
    local today_date
    today_date=$(date +"%Y-%m-%d")

    echo "📖 Starting Book: '$title'"
    echo "📊 Total: $total_pages pages | Pace: ~$pages_per_day pages/day"

    # Add the recurring task with UDA fields
    task add "Reading: $title (Page 0/$total_pages) (0-$pages_per_day)" \
        project:Health \
        +routine \
        +reading \
        +sprint \
        recur:daily \
        due:"$today_date 22:00" \
        wait:due-14h \
        book_title:"$title" \
        current_page:0 \
        total_pages:"$total_pages" \
        points:0

    echo "✅ Recurring habit created. It will wake up daily at 08:00 AM."
}

# Command Dispatcher
case "${1:-}" in
    planning)
        planning_ceremony
        ;;
    daily)
        daily_ceremony
        ;;
    review)
        review_ceremony
        ;;
    retro)
        retro_ceremony
        ;;
    refine)
        refine_ceremony
        ;;
    book)
        cmd_book "$2" "$3" 
      ;;
    doc)
        task_doc "${2:-}"
        ;;
    target)
        set_target "${2:-}"
        ;;
    add)
        add_task "${2:-}"
        ;;
    help|--help|-h)
        echo "SprintOS - Agile CLI Workflow"
        echo "Usage: sprint [command]"
        echo ""
        echo "Commands:"
        echo "  sprint                                   Show weekly dashboard & health"
        echo "  sprint daily                             Daily scrum (routines + top priorities)"
        echo "  sprint planning                          Sprint planning ceremony & backlog pool"
        echo "  sprint refine                            Backlog refinement (estimate unpointed tasks)"
        echo "  sprint review                            Sprint review & velocity completed since Saturday"
        echo "  sprint retro                             Sprint retrospective and markdown export"
        echo "  sprint book <book_title> <total_pages>   Book Tracking"
        echo "  sprint doc <id>                          Create/Open document for a task"
        echo "  sprint add <id>                          Commit backlog task into active sprint"
        echo "  sprint target <pts>                      Set weekly capacity target"
        ;;
    *)
        show_dashboard
        ;;
esac
