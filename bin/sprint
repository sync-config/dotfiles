#!/usr/bin/env bash
# File: ~/.dotfiles/bin/sprint
# SprintOS - A CLI Scrum Application for Taskwarrior

set -e

# Configuration
RAW_TARGET=$(task _get rc.sprint.target 2>/dev/null || true)
TARGET="${RAW_TARGET:-7}"
RETRO_FILE="$HOME/.sprint_retrospective.md"

show_header() {
    echo -e "\n==============================================="
    echo -e "         🚀 SPRINTOS | $1 "
    echo -e "==============================================="
}

# --- Scrum Ceremonies ---

# 1. PLANNING
planning_ceremony() {
    show_header "PLANNING"
    CURRENT_LOAD=$(task +sprint -routine status:pending export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    CURRENT_LOAD=${CURRENT_LOAD:-0}

    echo "Capacity Target: $TARGET pts"
    echo "Current Load:    $CURRENT_LOAD pts"
    echo -e "\nSuggested Ready Tasks:"
    task +READY -routine limit:5
    echo -e "\nUse 'sprint add <id>' to commit tasks to the sprint."
}

# 2. DAILY SCRUM
daily_ceremony() {
    show_header "DAILY SCRUM"

    echo "--- 🏃 Habits & Routines ---"
    task +routine status:pending limit:3

    echo -e "\n--- 🎯 Top Priorities for Today ---"
    task +sprint -routine status:pending limit:3

    echo -e "\n--- ⚠️ Blockers & Urgent Tasks ---"
    task +sprint priority:H or +expedite status:pending
}

# REFIND
refine_ceremony() {
    show_header "BACKLOG REFINEMENT"
    echo "Reviewing Epics and Unpointed/Large Tasks..."
    echo -e "\n--- 🐘 Large or Unpointed Tasks (Needs breakdown) ---"
    # تسک‌های بک‌لاگ که فاقد پوینت هستند یا پوینت بالایی دارند (>= 5)
    task -sprint -routine status:pending 'points == 0 or points >= 5 or points == ""'

    echo -e "\n--- 💡 Tips for Decomposition: ---"
    echo "1. Break Epics into 1-2 point tasks."
    echo "2. Wire dependencies: 'task <child_id> modify depends:<parent_id>'"
    echo "3. Assign points:     'task <id> modify points:1'"
}

# 3. REVIEW
review_ceremony() {
    show_header "REVIEW"
    VELOCITY=$(task +sprint -routine status:completed end.after:today-7days export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    VELOCITY=${VELOCITY:-0}

    ROUTINES_DONE=$(task +routine status:completed end.after:today-7days count 2>/dev/null || echo 0)

    echo "Project Velocity (last 7 days): $VELOCITY pts"
    echo "Routines Completed:             $ROUTINES_DONE sessions"
    echo -e "\nCompleted Sprint Tasks:"
    task +sprint -routine status:completed end.after:today-7days
}

# 4. RETROSPECTIVE
retro_ceremony() {
    show_header "RETROSPECTIVE"
    echo "Logging retrospective to: $RETRO_FILE"
    read -r -p "What went well this sprint? " well
    read -r -p "What needs improvement? " improve
    echo -e "## $(date '+%Y-%m-%d %H:%M')\n- **Went Well:** $well\n- **Improve:** $improve\n" >> "$RETRO_FILE"
    echo "Retrospective entry saved successfully."
}

# --- Application Router ---

case "$1" in
  planning) planning_ceremony ;;
  daily)    daily_ceremony ;;
  refind)   refine_ceremony;;
  review)   review_ceremony ;;
  retro)    retro_ceremony ;;

  add)
    TASK_ID="$2"
    if [ -z "$TASK_ID" ]; then
      echo "Usage: sprint add <task-id>"
      exit 1
    fi
    TASK_PTS=$(task _get "$TASK_ID.points" 2>/dev/null || echo 0)
    TASK_PTS=${TASK_PTS:-0}

    CURRENT=$(task +sprint -routine status:pending export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    CURRENT=${CURRENT:-0}
    NEW_TOTAL=$((CURRENT + TASK_PTS))

    if [ "$NEW_TOTAL" -gt "$TARGET" ]; then
      echo "⚠️  WARNING: Adding task #$TASK_ID ($TASK_PTS pts) exceeds weekly target ($NEW_TOTAL / $TARGET pts)!"
      read -r -p "Do you want to overcommit? [y/N]: " confirm
      if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        echo "Aborted."
        exit 0
      fi
    fi

    task "$TASK_ID" modify +sprint
    echo "Task #$TASK_ID added to sprint."
    ;;

  close)
    show_header "SPRINT CLOSE"
    VELOCITY=$(task +sprint -routine status:completed end.after:today-7days export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    echo "Sprint Velocity: ${VELOCITY:-0} pts"
    read -r -p "Demote remaining pending tasks to general backlog? [y/N]: " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
      task +sprint -routine status:pending modify -sprint
      echo "Incomplete tasks demoted to general backlog."
    fi
    ;;

  target)
    NEW_TARGET="$2"
    if [ -n "$NEW_TARGET" ]; then
      task config sprint.target "$NEW_TARGET"
      echo "Sprint capacity updated to: $NEW_TARGET pts"
    else
      echo "Current capacity target: $TARGET pts"
    fi
    ;;

  status|"")
    show_header "DASHBOARD"
    task sprint
    echo "-----------------------------------------------"
    COMMITTED=$(task +sprint -routine status:pending export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    COMMITTED=${COMMITTED:-0}
    DONE=$(task +sprint -routine status:completed end.after:today-7days export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    DONE=${DONE:-0}

    echo "📊 Project Capacity: $TARGET pts"
    echo "⏳ In Progress:     $COMMITTED pts"
    echo "✅ Project Done(7d): $DONE pts"

    if [ "$COMMITTED" -gt "$TARGET" ]; then
      echo "⚠️  WARNING: Committed sprint points exceed weekly capacity ($TARGET pts)!"
    fi
    echo "==============================================="
    ;;

  *)
    echo "SprintOS Commands:"
    echo "  sprint [status]       - View sprint board and metrics"
    echo "  sprint planning       - Run weekly sprint planning"
    echo "  sprint daily          - Run daily standup check"
    echo "  sprint review         - View sprint completion stats"
    echo "  sprint retro          - Record retrospective feedback"
    echo "  sprint add <id>       - Add a backlog task to current sprint"
    echo "  sprint close          - Close sprint and handle incomplete tasks"
    echo "  sprint target <pts>   - Set or view weekly capacity target"
    ;;
esac
