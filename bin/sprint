#!/usr/bin/env bash
# File: ~/.dotfiles/bin/sprint
# SprintOS - A CLI Scrum Application for Taskwarrior

# --- Configuration & Helpers ---
TARGET=$(task _get rc.sprint.target 2>/dev/null || echo 7)
RETRO_FILE="$HOME/.sprint_retrospective.md"

function show_header() {
    echo -e "\n==============================================="
    echo -e "         🚀 SPRINTOS | $1 "
    echo -e "==============================================="
}

# --- Core Scrum Ceremonies ---

# 1. PLANNING
planning_ceremony() {
    show_header "PLANNING"
    CURRENT_LOAD=$(task +sprint status:pending export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    echo "Capacity Target: $TARGET pts"
    echo "Current Load:    $CURRENT_LOAD pts"
    echo -e "\nSuggested Ready Tasks:"
    task +READY limit:5
    echo -e "\nUse 'sprint add <id>' to add tasks to the sprint."
}

# 2. DAILY SCRUM
daily_ceremony() {
    show_header "DAILY SCRUM"
    echo "--- Yesterday Completed ---"
    task +sprint status:completed end.after:yesterday
    echo -e "\n--- Top Priorities for Today ---"
    task +sprint status:pending limit:3
    echo -e "\n--- Blockers/Urgent ---"
    task +sprint priority:H or +expedite
}

# 3. REVIEW
review_ceremony() {
    show_header "REVIEW"
    VELOCITY=$(task +sprint status:completed end.after:today-7days export 2>/dev/null | jq '[.[].points // 0] | add' 2>/dev/null || echo 0)
    echo "Sprint Velocity (last 7 days): $VELOCITY pts"
    echo -e "\nCompleted Accomplishments:"
    task +sprint status:completed
}

# 4. RETROSPECTIVE
retro_ceremony() {
    show_header "RETROSPECTIVE"
    echo "Log your thoughts to: $RETRO_FILE"
    read -r -p "What went well this sprint? " well
    read -r -p "What needs improvement? " improve
    echo -e "## $(date)\n- Well: $well\n- Improve: $improve\n" >> "$RETRO_FILE"
    echo "Retrospective entry saved successfully."
}

# --- Application Entry Point ---

case "$1" in
  planning) planning_ceremony ;;
  daily)    daily_ceremony ;;
  review)   review_ceremony ;;
  retro)    retro_ceremony ;;
  
  add)
    TASK_ID="$2"
    task "$TASK_ID" modify +sprint
    echo "Task #$TASK_ID added."
    ;;

  status|*)
    # Default Dashboard
    show_header "DASHBOARD"
    task sprint
    ;;
esac
