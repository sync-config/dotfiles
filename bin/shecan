#!/usr/bin/env zsh

# Cheking run script with root acess!
if [[ $EUID -ne 0 ]]; then
	echo "This script should run with accssec superuser!!!"
	exit 1
fi

# Path file for cheking status run
LOCK_FILE="/var/tmp/dns_switch.lock"

# Checking status previus run
if [[ -f "$LOCK_FILE" ]]; then
	PREV_RUN=$(cat "$LOCK_FILE")
else
	PREV_RUN=0
fi

# Unlock file `/etc/resolv.conf`
chattr -i /etc/resolv.conf

# Chenging dns
if [[ "$PREV_RUN" -eq 0 ]]; then
	echo "nameserver 8.8.8.8" > /etc/resolv.conf
	echo "nameserver 8.8.4.4" >> /etc/resolv.conf
	echo "2" > "$LOCK_FILE"
	echo "Chenging dns to google"
elif [[ "$PREV_RUN" -eq 2 ]]; then
	echo "nameserver 1.1.1.1" > /etc/resolv.conf
	echo "nameserver 1.0.0.1" >> /etc/resolv.conf
	echo "1" > "$LOCK_FILE"
	echo "Chenging dns to cloudflare"
else
	echo "nameserver 185.51.200.2" > /etc/resolv.conf
	echo "nameserver 178.22.122.100" >> /etc/resolv.conf
	echo "0" > "$LOCK_FILE"
	echo "Chenging dns to shecan"
fi
	
# Lock `/etc/resolv.conf`
chattr +i /etc/resolv.conf

echo "lock dns file"
