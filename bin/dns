#!/usr/bin/env bash

set -euo pipefail

if command -v realpath >/dev/null 2>&1; then
  SCRIPT_PATH="$(realpath "$0")"
else
  SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || echo "$0")"
fi

BIN_DIR="$(dirname "$SCRIPT_PATH")"
DOTFILES_DIR="$(dirname "$BIN_DIR")"
LIB_DIR="$DOTFILES_DIR/lib/dns"

if [[ ! -d "$LIB_DIR" ]]; then
  echo "Error: DNS module library directory not found at '$LIB_DIR'" >&2
  exit 1
fi

for module in "$LIB_DIR"/*.sh; do
  [[ -f "$module" ]] && source "$module"
done

cmd_help() {
  cat <<EOF
  Usage: dns <command>

  Commands:
    status  Display current DNS config and immutable (+i) status (No root required)
    shecan  Set DNS to shecan nameservers and lock the file (Root required)
    lock    Make /etc/resolv.conf immutable with chattr +i (Root required)
    unlock  Remove immutable attribute with chattr -i (Root required)
    help    Show this help message 
EOF
}


case "${1:-}" in
  status)
    cmd_status
    ;;

  "")
    cmd_status
    ;;

  *)
    echo "Error: Unknown command '${1}'" >&2
    echo "" >&2
    cmd_help >&2
    exit 1
    ;;
esac

