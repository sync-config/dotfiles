#!/usr/bin/env bash
#
# scripts/ide - Create a 3-pane tmux development layout with:
#   1. Master pane (Top-Left): Primary development / Editor
#   2. Terminal pane (Bottom-Left): Build, test, and shell commands
#   3. Agent pane (Right): AI Agent environment
#
# configuration precedence (highest -> lowest)
#   1. CLI argument              (e.g. `bin/ide aider`)
#   2. Explicit env variable     (e.g. `AI_AGENT_CMD=claude bin/ide`)
#   3. project .env              ($PWD/.env)
#   4. Global dotfiles config    (~/.config/ide/ide.env)
#   5. Script defaults           (opencode, 25%, 30%)

set -euo pipefail

# Variables allowed to be loaded from .env files
readonly _ENV_KEYS=(AI_AGENT_CMD IDE_AGENT_WIDTH IDE_TERM_HEIGHT)

# -----------------------------------------------------------------------
# Safe .env loader (no `source` -> no code injection from untusted files)
# -----------------------------------------------------------------------
load_env_file() {
  local file="${1:-}"
  local key=""
  local value=""
  local line=""
  local alllowed=""

  [ -f "$file" ] || return 0

  while IFS= read -r line || [ -n "$line" ]; do
    # strip comments
    line="${line%%\#*}"
    # trim leading/trailing whitespace (pure bash)
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -z "$line" ] && continue

    case "$line" in
      *=*) ;; # KEY=VALUE
      *) continue ;;
    esac

    key="${line%%=*}"
    value="${line#*=}"

    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]*}"}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]*}"}"

    # Trim single and double quotes safely
    value="${value#\"}"
    value="${value%\"}"
    value="${value#\'}"
    value="${value%\'}"


    # only accept whitelisted keys
    for allowed in "${_ENV_KEYS[@]}"; do
      if [[ "$key" = "$allowed" ]]; then
        # Never override a variable that is already set in the environment
        # so explicit shell exports keep priority over the .env file.
        if [ -z "${!allowed+x}" ]; then
          printf -v "$allowed" '%s' "$value"
          export "$allowed"
        fi
      fi
    done
  done < "$file"
}


# -----------------------------------------------------------------------
# Load configuration: project .env first, then global dotfiles config
# -----------------------------------------------------------------------
load_config() {
  load_env_file "${HOME}/.config/ide/ide.conf"
}

# -----------------------------------------------------------------------
# Load configuration: project .env first, then global dotfiles config
# -----------------------------------------------------------------------
apply_defaults() {
  : "${AI_AGENT_CMD:=opencode}"
  : "${IDE_AGENT_WIDTH:=25}"
  : "${IDE_TERM_HEIGHT:=30}"
}

# Check prerequisites
validate_environment() {
  if ! command -v tmux >/dev/null 2>&1; then
    echo "Error: tmux is not installed or not found in PATH." >&2
    exit 1
  fi

  if [ -z "${TMUX:-}" ]; then
    echo "Error: scripts/ide must be run from inside an active tmux session." >&2
    exit 1
  fi
}

# Create the 3-pane layout
setup_workspace() {
  local agent_cmd="${1:-$AI_AGENT_CMD}"
  local base_pane=""
  local agent_pane=""
  local term_pane=""


  # Get current window and active pane
  base_pane="$(tmux display-message -p '#{pane_id}')"

  # Close any other existing panes in the current window to ensure a clean slate
  # (Avoids "size or position invalid" caused by dividing an already split window)
  tmux kill-pane -a -t "$base_pane" 2>/dev/null || true

  # 1. Create the right-side Agent Pane spanning the full height
  agent_pane="$(tmux split-window -h -l "${IDE_AGENT_WIDTH}%" -c "#{pane_current_path}" -P -F "#{pane_id}" 2>/dev/null || \
                tmux split-window -h -p "$IDE_AGENT_WIDTH" -c "#{pane_current_path}" -P -F "#{pane_id}")"

  # 2. Return focus to the base pane and create the bottom Terminal Pane
  tmux select-pane -t "$base_pane"
  term_pane="$(tmux split-window -v -l "${IDE_TERM_HEIGHT}%" -c "#{pane_current_path}" -P -F "#{pane_id}" 2>/dev/null || \
               tmux split-window -v -p "$IDE_TERM_HEIGHT" -c "#{pane_current_path}" -P -F "#{pane_id}")"

  # 3. Launch AI Agent inside the Agent pane
  if [ -n "$agent_cmd" ]; then
    tmux send-keys -t "$agent_pane" "$agent_cmd" C-m
  fi

  # 4. Focus back on the Master (top-left) pane for active development
  tmux select-pane -t "$base_pane"
}

main() {
  validate_environment

  load_config
  apply_defaults

  # CLI argument has the highest priority (overides everything)
  local agent_cmd="${1:-$AI_AGENT_CMD}"

  #printf 'agent_cmd would be: [%s]\n' "$agent_cmd"
  #echo "AI_AGENT_CMD env = [${AI_AGENT_CMD:-}]"

  setup_workspace "$agent_cmd"
}

main "$@"
